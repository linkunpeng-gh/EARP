{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "earp:catalog-profile:schema:v2",
  "title": "EARP Catalog Profile Schema v2",
  "description": "项目级 Catalog 治理配置（值层）。v2 变更：一 Profile 一 domain（data_domain 单值）、roles 改为可配置数组（不硬编码 6 个角色）、增加 backup_approver。禁止加入 allow_inactive、disable_fail_closed 等危险语义开关——additionalProperties:false。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile_id",
    "schema_version",
    "template_contract_version",
    "industry_scope",
    "enterprise_scope",
    "tenant_id",
    "data_domain",
    "catalog_profile_id",
    "pack_lock",
    "roles",
    "backup_approver",
    "change_orders",
    "record_keeper"
  ],
  "properties": {
    "profile_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "schema_version": {
      "const": "catalog-profile/v2"
    },
    "template_contract_version": {
      "type": "string",
      "minLength": 1,
      "description": "所采用的签署模板契约版本，如 n01a-catalog-phase0-signoff/v1"
    },
    "industry_scope": {
      "type": "string",
      "minLength": 1
    },
    "enterprise_scope": {
      "type": "string",
      "minLength": 1
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1
    },
    "data_domain": {
      "type": "string",
      "minLength": 1,
      "description": "一 Profile 一 domain（FROZEN）。多 domain 项目创建多个 Profile。"
    },
    "catalog_profile_id": {
      "type": "string",
      "minLength": 1,
      "description": "有效 catalog profile 标识（对应 effective manifest 绑定），格式 {industry}.{enterprise}.{tenant}.{data_domain}"
    },
    "pack_lock": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["pack_id", "layer", "version"],
        "properties": {
          "pack_id": { "type": "string", "minLength": 1 },
          "layer": { "enum": ["platform", "industry", "enterprise"] },
          "version": { "type": ["string", "null"] },
          "content_hash": { "type": ["string", "null"] }
        }
      }
    },
    "roles": {
      "type": "array",
      "minItems": 1,
      "description": "可配置角色列表（不硬编码角色数量和名称）。每个角色绑定人员，一人可兼任多角色。",
      "items": { "$ref": "#/$defs/role_binding" }
    },
    "backup_approver": {
      "type": "string",
      "minLength": 1,
      "description": "候补审批人角色 key（对应 roles 中的 role_key）。当唯一审批人也是申请人时，自动路由到此角色。"
    },
    "change_orders": {
      "type": "object",
      "additionalProperties": false,
      "required": ["change", "release"],
      "properties": {
        "change": { "type": "string", "minLength": 1 },
        "release": { "type": "string", "minLength": 1 }
      }
    },
    "record_keeper": {
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "role_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role_key", "name", "team"],
      "properties": {
        "role_key": {
          "type": "string",
          "minLength": 1,
          "description": "角色标识，如 product_owner、platform_architect、data_domain_owner 等，由项目自定义"
        },
        "name": { "type": "string", "minLength": 1 },
        "team": { "type": "string", "minLength": 1 },
        "contact": { "type": ["string", "null"] }
      }
    }
  }
}
