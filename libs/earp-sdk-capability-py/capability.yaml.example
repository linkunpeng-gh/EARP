# EARP Capability SDK 配置
# 环境变量使用 ${VAR_NAME} 语法，运行时自动替换。
# 优先级：CLI 参数 > 环境变量 > yaml 文件 > 默认值

earp:
  registry:
    # Capability Center 地址
    api_url: "http://localhost:8080"
    # 调试模式：注册后自动激活
    auto_register: false
    # HTTP 请求超时（秒）
    timeout_seconds: 30

  runtime:
    # Capability 执行默认超时（毫秒）
    default_timeout_ms: 30000
    # 全局最大重试次数（0 = 不重试）
    max_retries: 0

connectors:
  # 连接器按名称注册，capability 内部通过 ctx.connectors.<name> 访问
  mes:
    type: rest
    base_url: "${MES_BASE_URL}"
    auth:
      type: bearer
      token: "${MES_API_TOKEN}"
    timeout_ms: 5000
    retry:
      max_attempts: 3
      backoff: exponential

  database:
    type: jdbc
    dsn: "${DB_DSN}"
    auth:
      type: basic
      username: "${DB_USER}"
      password: "${DB_PASS}"
    pool_size: 10
    timeout_ms: 10000
    retry:
      max_attempts: 2
      backoff: linear
