  "rules": [
    {
      "rule_key": "rule-production-drop-detection",
      "node_key": "production_output",
      "rule_schema_ref": {
        "kind": "rule_schema",
        "stable_id": "common.rule.direction_rule",
        "version": "1.0.0"
      },
      "rule_params": {
        "operator": "relative_change_lte",
        "threshold": -0.10,
        "direction": "down"
      },
      "business_description": "当日产量相对基线下降超过10%时，标记为产量下降异常。"
    },
    {
      "rule_key": "rule-equipment-low-availability",
      "node_key": "equipment_availability",
      "rule_schema_ref": {
        "kind": "rule_schema",
        "stable_id": "common.rule.threshold",
        "version": "1.0.0"
      },
      "rule_params": {
        "operator": "absolute_lte",
        "threshold": 0.90
      },
      "business_description": "当设备可用率低于90%时，标记为设备可用率异常，可能是产量下降的原因。"
    },
    {
      "rule_key": "rule-cycle-time-increase",
      "node_key": "haulage_cycle_time",
      "rule_schema_ref": {
        "kind": "rule_schema",
        "stable_id": "common.rule.direction_rule",
        "version": "1.0.0"
      },
      "rule_params": {
        "operator": "relative_change_gte",
        "threshold": 0.20,
        "direction": "up"
      },
      "business_description": "当运输周期相对基线增加超过20%时，标记为运输周期异常，可能是产量下降的原因。"
    },
    {
      "rule_key": "rule-queue-time-increase",
      "node_key": "haulage_queue_time",
      "rule_schema_ref": {
        "kind": "rule_schema",
        "stable_id": "common.rule.direction_rule",
        "version": "1.0.0"
      },
      "rule_params": {
        "operator": "relative_change_gte",
        "threshold": 0.50,
        "direction": "up"
      },
      "business_description": "当排队时间相对基线增加超过50%时，标记为排队拥堵异常，作为运输问题的佐证。"
    },
    {
      "rule_key": "rule-quality-stable",
      "node_key": "ore_quality",
      "rule_schema_ref": {
        "kind": "rule_schema",
        "stable_id": "common.rule.predicate",
        "version": "1.0.0"
      },
      "rule_params": {
        "operator": "absolute_relative_change_lt",
        "threshold": 0.05
      },
      "business_description": "当原矿品位相对基线变化小于5%时，认为品位稳定，可排除质量因素。"
    }
  ],
  "demo_scenario": {
    "scenario_name": "3号矿8月下旬产量下降事件",
    "time_range": "2026-08-20 至 2026-08-31",
    "expected_diagnosis": "运输周期变长（+50%）和设备可用率下降（至80-83%）是产量下降的主要原因，排队时间增加（+200%）进一步加剧了运输瓶颈，原矿品位基本稳定可排除。",
    "dataset_id": "mine3-production-demo",
    "dataset_path": "example/knowledge-center/file-dataset/"
  }
}
