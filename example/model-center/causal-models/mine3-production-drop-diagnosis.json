{
  "schema_version": "causal-model-demo/v1",
  "description": "煤矿开采行业演示因果模型——3号矿产量下降诊断。用于ECMC模型中心新建模型、编辑、校验、审核发布、编译、激活全流程演示。",
  "model_info": {
    "model_name": "3号矿产量下降诊断",
    "model_type": "causal",
    "data_domain": "production_data",
    "target_entity_type": "mine",
    "diagnostic_direction": "down",
    "entry_node_key": "production_output",
    "time_window_schema": "daily_production_window",
    "business_description": "用于诊断3号矿日产量低于计划基线时的主要业务原因。通过分析运输周期、设备可用率、排队时间、原矿品位等因素，定位产量下降的根因。"
  },
  "nodes": [
    {
      "node_key": "production_output",
      "business_name": "原煤产量",
      "entity_type_catalog_ref": {
        "kind": "entity_type",
        "stable_id": "coal.mine",
        "version": "1.0.0"
      },
      "observability": "observable",
      "is_entry_node": true,
      "notes": "入口节点，诊断目标。按日统计的原煤产量，单位吨。"
    },
    {
      "node_key": "effective_production_capacity",
      "business_name": "有效生产能力",
      "entity_type_catalog_ref": {
        "kind": "entity_type",
        "stable_id": "coal.mine",
        "version": "1.0.0"
      },
      "observability": "indirectly_observable",
      "is_entry_node": false,
      "notes": "中间节点。综合设备、运输等因素后的实际生产能力，无法直接测量，通过其他因素推断。"
    },
    {
      "node_key": "equipment_availability",
      "business_name": "关键设备可用率",
      "entity_type_catalog_ref": {
        "kind": "entity_type",
        "stable_id": "coal.equipment_group",
        "version": "1.0.0"
      },
      "observability": "observable",
      "is_entry_node": false,
      "notes": "原因节点。综采设备组的日可用率，设备故障、维护不及时会导致可用率下降，进而影响产量。"
    },
    {
      "node_key": "haulage_cycle_time",
      "business_name": "矿卡运输周期",
      "entity_type_catalog_ref": {
        "kind": "entity_type",
        "stable_id": "coal.haulage_system",
        "version": "1.0.0"
      },
      "observability": "observable",
      "is_entry_node": false,
      "notes": "原因节点。矿卡完成一次运输循环的平均时间，包括装车、重车运行、卸车、空车返回。周期变长意味着单位时间运输量减少。"
    },
    {
      "node_key": "haulage_queue_time",
      "business_name": "装载点排队时间",
      "entity_type_catalog_ref": {
        "kind": "entity_type",
        "stable_id": "coal.haulage_system",
        "version": "1.0.0"
      },
      "observability": "observable",
      "is_entry_node": false,
      "notes": "原因节点。矿卡到达装载点后等待装载的平均时间。排队时间增加说明运输系统存在拥堵，可能是装载机不足或装载效率下降。"
    },
    {
      "node_key": "ore_quality",
      "business_name": "原矿品位",
      "entity_type_catalog_ref": {
        "kind": "entity_type",
        "stable_id": "coal.mine",
        "version": "1.0.0"
      },
      "observability": "observable",
      "is_entry_node": false,
      "notes": "原因节点。原煤的质量指标，如灰分、发热量等。品位变化可能影响洗选回收率，但对原煤产量影响较小。"
    }
  ],
  "edges": [
    {
      "edge_key": "edge-equipment-to-capacity",
      "source_node_key": "equipment_availability",
      "target_node_key": "effective_production_capacity",
      "relation_type_catalog_ref": {
        "kind": "relation_type",
        "stable_id": "coal.affects_production_capacity",
        "version": "1.0.0"
      },
      "effect": "+",
      "strength": 0.85,
      "confidence": 0.95,
      "lag": 0,
      "rationale": "设备可用率越高，有效生产能力越强。设备故障停机直接导致采煤工作面无法正常生产。"
    },
    {
      "edge_key": "edge-cycle-to-capacity",
      "source_node_key": "haulage_cycle_time",
      "target_node_key": "effective_production_capacity",
      "relation_type_catalog_ref": {
        "kind": "relation_type",
        "stable_id": "coal.affects_production_capacity",
        "version": "1.0.0"
      },
      "effect": "-",
      "strength": 0.90,
      "confidence": 0.95,
      "lag": 0,
      "rationale": "运输周期越长，单位时间运输量越少，有效生产能力越低。运输是煤矿生产的关键瓶颈环节。"
    },
    {
      "edge_key": "edge-queue-to-capacity",
      "source_node_key": "haulage_queue_time",
      "target_node_key": "effective_production_capacity",
      "relation_type_catalog_ref": {
        "kind": "relation_type",
        "stable_id": "coal.affects_production_capacity",
        "version": "1.0.0"
      },
      "effect": "-",
      "strength": 0.80,
      "confidence": 0.90,
      "lag": 0,
      "rationale": "排队时间越长，矿卡有效作业时间越少，运输效率下降，进而影响整体生产能力。"
    },
    {
      "edge_key": "edge-capacity-to-output",
      "source_node_key": "effective_production_capacity",
      "target_node_key": "production_output",
      "relation_type_catalog_ref": {
        "kind": "relation_type",
        "stable_id": "coal.determines_production_output",
        "version": "1.0.0"
      },
      "effect": "+",
      "strength": 0.95,
      "confidence": 0.98,
      "lag": 0,
      "rationale": "有效生产能力直接决定原煤产量。在需求稳定的情况下，产量主要受生产能力约束。"
    },
    {
      "edge_key": "edge-quality-to-output",
      "source_node_key": "ore_quality",
      "target_node_key": "production_output",
      "relation_type_catalog_ref": {
        "kind": "relation_type",
        "stable_id": "coal.affects_production_output",
        "version": "1.0.0"
      },
      "effect": "+",
      "strength": 0.55,
      "confidence": 0.85,
      "lag": 0,
      "rationale": "原矿品位对原煤产量有一定影响，但影响程度相对较小。品位变化主要影响精煤产量和洗选回收率。"
    }
  ],
