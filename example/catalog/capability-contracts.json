{
  "schema_version": "earp-demo-catalog-capability-contracts/v1",
  "description": "煤矿开采行业演示能力合同定义（Catalog Capability Contract），用于因果模型证据需求的取数能力声明和文件场景数据集的Provider绑定",
  "capability_contracts": [
    {
      "kind": "capability_contract",
      "stable_id": "coal.capability.production_metric_query",
      "version": "1.0.0",
      "capability_id": "production_metric_query",
      "name": "产量指标查询",
      "role": "primary",
      "description": "查询指定矿山在指定时间窗口内的原煤产量实际值和计划基线值",
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["entity_id", "time_window"],
        "properties": {
          "entity_id": {
            "type": "string",
            "description": "目标矿山实体ID"
          },
          "time_window": {
            "type": "object",
            "properties": {
              "start": {"type": "string", "format": "date-time"},
              "end": {"type": "string", "format": "date-time"}
            }
          },
          "aggregation": {
            "type": "string",
            "default": "sum",
            "description": "聚合方式"
          }
        }
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["value", "baseline", "unit"],
        "properties": {
          "value": {
            "type": "number",
            "description": "实际产量值"
          },
          "baseline": {
            "type": "number",
            "description": "计划基线产量值"
          },
          "unit": {
            "type": "string",
            "description": "计量单位，固定为吨(t)"
          },
          "data_points": {
            "type": "integer",
            "description": "参与聚合的数据点数量"
          },
          "provenance": {
            "type": "object",
            "properties": {
              "source": {"type": "string"},
              "dataset_id": {"type": "string"},
              "content_hash": {"type": "string"}
            }
          }
        }
      }
    },
    {
      "kind": "capability_contract",
      "stable_id": "coal.capability.equipment_availability_query",
      "version": "1.0.0",
      "capability_id": "equipment_availability_query",
      "name": "设备可用率查询",
      "role": "primary",
      "description": "查询指定设备组在指定时间窗口内的设备可用率实际值和目标基线值",
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["entity_id", "time_window"],
        "properties": {
          "entity_id": {
            "type": "string",
            "description": "目标设备组实体ID"
          },
          "time_window": {
            "type": "object",
            "properties": {
              "start": {"type": "string", "format": "date-time"},
              "end": {"type": "string", "format": "date-time"}
            }
          },
          "aggregation": {
            "type": "string",
            "default": "avg",
            "description": "聚合方式"
          }
        }
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["value", "baseline", "unit"],
        "properties": {
          "value": {
            "type": "number",
            "description": "实际可用率，0-1之间的小数"
          },
          "baseline": {
            "type": "number",
            "description": "目标基线可用率"
          },
          "unit": {
            "type": "string",
            "description": "计量单位，固定为比率(ratio)"
          },
          "equipment_count": {
            "type": "integer",
            "description": "设备组内设备总数"
          },
          "failure_count": {
            "type": "integer",
            "description": "时间窗口内故障次数"
          }
        }
      }
    },
    {
      "kind": "capability_contract",
      "stable_id": "coal.capability.equipment_failure_log_query",
      "version": "1.0.0",
      "capability_id": "equipment_failure_log_query",
      "name": "设备故障记录查询",
      "role": "supporting",
      "description": "查询指定设备组在指定时间窗口内的设备故障记录明细，作为设备可用率异常的佐证",
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["entity_id", "time_window"],
        "properties": {
          "entity_id": {"type": "string"},
          "time_window": {
            "type": "object",
            "properties": {
              "start": {"type": "string", "format": "date-time"},
              "end": {"type": "string", "format": "date-time"}
            }
          }
        }
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "failures": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "equipment_id": {"type": "string"},
                "failure_type": {"type": "string"},
                "failure_time": {"type": "string", "format": "date-time"},
                "recovery_time": {"type": "string", "format": "date-time"},
                "downtime_minutes": {"type": "number"},
                "description": {"type": "string"}
              }
            }
          },
          "total_failures": {"type": "integer"},
          "total_downtime_minutes": {"type": "number"}
        }
      }
    },
    {
      "kind": "capability_contract",
      "stable_id": "coal.capability.haulage_metric_query",
      "version": "1.0.0",
      "capability_id": "haulage_metric_query",
      "name": "运输指标查询",
      "role": "primary",
      "description": "查询指定运输系统在指定时间窗口内的运输周期和排队时间等运输效率指标",
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["entity_id", "time_window", "metric_type"],
        "properties": {
          "entity_id": {
            "type": "string",
            "description": "目标运输系统实体ID"
          },
          "time_window": {
            "type": "object",
            "properties": {
              "start": {"type": "string", "format": "date-time"},
              "end": {"type": "string", "format": "date-time"}
            }
          },
          "metric_type": {
            "type": "string",
            "enum": ["cycle_time", "queue_time", "transport_volume"],
            "description": "查询的指标类型"
          },
          "aggregation": {
            "type": "string",
            "default": "avg",
            "description": "聚合方式"
          }
        }
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["value", "baseline", "unit"],
        "properties": {
          "value": {
            "type": "number",
            "description": "实际指标值"
          },
          "baseline": {
            "type": "number",
            "description": "正常基线值"
          },
          "unit": {
            "type": "string",
            "description": "计量单位，周期/排队时间为分钟(min)，运输量为吨(t)"
          },
          "truck_count": {
            "type": "integer",
            "description": "参与统计的矿卡数量"
          },
          "total_trips": {
            "type": "integer",
            "description": "时间窗口内运输趟次"
          }
        }
      }
    },
    {
      "kind": "capability_contract",
      "stable_id": "coal.capability.quality_metric_query",
      "version": "1.0.0",
      "capability_id": "quality_metric_query",
      "name": "质量指标查询",
      "role": "primary",
      "description": "查询指定矿山在指定时间窗口内的原矿品位、灰分、发热量等质量指标",
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["entity_id", "time_window"],
        "properties": {
          "entity_id": {"type": "string"},
          "time_window": {
            "type": "object",
            "properties": {
              "start": {"type": "string", "format": "date-time"},
              "end": {"type": "string", "format": "date-time"}
            }
          },
          "quality_type": {
            "type": "string",
            "enum": ["quality_index", "ash_content", "calorific_value", "sulfur_content"],
            "default": "quality_index"
          }
        }
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["value", "baseline", "unit"],
        "properties": {
          "value": {"type": "number"},
          "baseline": {"type": "number"},
          "unit": {"type": "string"},
          "sample_count": {"type": "integer"},
          "lab_report_id": {"type": "string"}
        }
      }
    }
  ]
}
