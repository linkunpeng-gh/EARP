    },
    {
      "relation_type_id": "located_in",
      "name": "位于",
      "source_type": "coal_face",
      "target_type": "mine",
      "cardinality": "many_to_one",
      "description": "采煤工作面位于某矿山"
    },
    {
      "relation_type_id": "responsible_for",
      "name": "负责",
      "source_type": "team",
      "target_type": "coal_face",
      "cardinality": "many_to_many",
