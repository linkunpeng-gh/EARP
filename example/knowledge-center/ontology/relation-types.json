      "description": "矿山按功能划分拥有多个设备组"
    },
    {
      "relation_type_id": "has_coal_face",
      "name": "拥有采煤工作面",
      "source_type": "mine",
      "target_type": "coal_face",
      "cardinality": "one_to_many",
      "description": "矿山拥有多个采煤工作面"
    },
    {
      "relation_type_id": "has_heading_face",
      "name": "拥有掘进工作面",
      "source_type": "mine",
      "target_type": "heading_face",
      "cardinality": "one_to_many",
      "description": "矿山拥有多个掘进工作面"
    },
    {
