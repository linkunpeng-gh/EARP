      "description": "运输系统为采煤工作面提供煤炭运输服务"
    },
    {
      "relation_type_id": "supports",
      "name": "支护",
      "source_type": "hydraulic_support",
      "target_type": "coal_face",
      "cardinality": "many_to_one",
      "description": "液压支架为采煤工作面提供顶板支护"
    }
