    },
    {
      "relation_type_id": "operated_by",
      "name": "由...操作",
      "source_type": "shearer",
      "target_type": "employee",
      "cardinality": "many_to_one",
      "description": "设备由特定员工操作"
    },
    {
      "relation_type_id": "transports_for",
      "name": "为...运输",
      "source_type": "transport_system",
      "target_type": "coal_face",
